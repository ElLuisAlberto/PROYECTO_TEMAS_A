<?xml version="1.0"?>
<package format="3">
  <name>kinova_direct_bridge</name><version>0.1.0</version>
  <description>Direct ROS 2 interface to the Kinova USB SDK.</description>
  <maintainer email="maintainer@example.com">Maintainer</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend><depend>sensor_msgs</depend><depend>geometry_msgs</depend>
