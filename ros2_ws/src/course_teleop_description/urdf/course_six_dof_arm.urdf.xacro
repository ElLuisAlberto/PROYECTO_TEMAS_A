<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="course_six_dof_arm">

  <!--
    Integration substitute only. This primitive model validates the complete
    ROS 2 / Gazebo control path but is not a geometric or dynamic Jaco2 model.
  -->

  <xacro:macro name="cylinder_link"
               params="name radius length mass color">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length / 2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="${color}"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${length / 2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${length / 2.0}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia
          ixx="${mass * (3.0 * radius * radius + length * length) / 12.0}"
          ixy="0.0"
          ixz="0.0"
          iyy="${mass * (3.0 * radius * radius + length * length) / 12.0}"
          iyz="0.0"
          izz="${mass * radius * radius / 2.0}"/>
      </inertial>
    </link>
    <gazebo reference="${name}">
      <gravity>false</gravity>
      <material>Gazebo/${color}</material>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="revolute_joint"
               params="name parent child xyz axis lower upper effort velocity">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="${axis}"/>
      <limit lower="${lower}" upper="${upper}"
             effort="${effort}" velocity="${velocity}"/>
      <dynamics damping="0.25" friction="0.02"/>
    </joint>
  </xacro:macro>

  <material name="DarkGrey">
    <color rgba="0.18 0.20 0.24 1.0"/>
  </material>
  <material name="Blue">
    <color rgba="0.10 0.35 0.80 1.0"/>
  </material>
  <material name="Orange">
    <color rgba="0.95 0.45 0.08 1.0"/>
  </material>
  <material name="Silver">
    <color rgba="0.70 0.73 0.78 1.0"/>
  </material>

  <link name="world"/>
  <xacro:cylinder_link
    name="base_link" radius="0.11" length="0.15" mass="4.0"
    color="DarkGrey"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:cylinder_link
    name="shoulder_link" radius="0.075" length="0.16" mass="2.0"
    color="Blue"/>
  <xacro:revolute_joint
    name="joint_1" parent="base_link" child="shoulder_link"
    xyz="0 0 0.15" axis="0 0 1"
    lower="-2.90" upper="2.90" effort="60" velocity="1.0"/>

  <xacro:cylinder_link
    name="upper_arm_link" radius="0.055" length="0.36" mass="2.0"
    color="Silver"/>
  <xacro:revolute_joint
    name="joint_2" parent="shoulder_link" child="upper_arm_link"
    xyz="0 0 0.16" axis="0 1 0"
    lower="-2.00" upper="2.00" effort="60" velocity="1.0"/>

  <xacro:cylinder_link
    name="forearm_link" radius="0.050" length="0.30" mass="1.5"
    color="Blue"/>
  <xacro:revolute_joint
    name="joint_3" parent="upper_arm_link" child="forearm_link"
    xyz="0 0 0.36" axis="0 1 0"
    lower="-2.60" upper="2.60" effort="50" velocity="1.0"/>

  <xacro:cylinder_link
    name="wrist_1_link" radius="0.045" length="0.14" mass="0.8"
    color="Orange"/>
  <xacro:revolute_joint
    name="joint_4" parent="forearm_link" child="wrist_1_link"
    xyz="0 0 0.30" axis="1 0 0"
    lower="-2.90" upper="2.90" effort="30" velocity="1.2"/>

  <xacro:cylinder_link
    name="wrist_2_link" radius="0.040" length="0.12" mass="0.6"
    color="Silver"/>
  <xacro:revolute_joint
    name="joint_5" parent="wrist_1_link" child="wrist_2_link"
    xyz="0 0 0.14" axis="0 1 0"
    lower="-2.00" upper="2.00" effort="25" velocity="1.2"/>

  <xacro:cylinder_link
    name="tool_link" radius="0.035" length="0.10" mass="0.4"
    color="Orange"/>
  <xacro:revolute_joint
    name="joint_6" parent="wrist_2_link" child="tool_link"
    xyz="0 0 0.12" axis="0 0 1"
    lower="-2.90" upper="2.90" effort="20" velocity="1.5"/>

  <link name="tool_frame">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0"
               iyy="0.000001" iyz="0.0" izz="0.000001"/>
    </inertial>
  </link>
  <joint name="tool_fixed_joint" type="fixed">
    <parent link="tool_link"/>
    <child link="tool_frame"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>
  <gazebo reference="tool_fixed_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="joint_1">
      <command_interface name="position">
        <param name="min">-2.90</param><param name="max">2.90</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_2">
      <command_interface name="position">
        <param name="min">-2.00</param><param name="max">2.00</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_3">
      <command_interface name="position">
        <param name="min">-2.60</param><param name="max">2.60</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_4">
      <command_interface name="position">
        <param name="min">-2.90</param><param name="max">2.90</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_5">
      <command_interface name="position">
        <param name="min">-2.00</param><param name="max">2.00</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_6">
      <command_interface name="position">
        <param name="min">-2.90</param><param name="max">2.90</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(find course_teleop_simulation)/config/controllers.yaml</parameters>
      <controller_manager_name>controller_manager</controller_manager_name>
    </plugin>
  </gazebo>
</robot>
