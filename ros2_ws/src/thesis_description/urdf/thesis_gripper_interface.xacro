<?xml version="1.0"?>
<!--
  Deliberately geometry-free integration contract for the thesis gripper.

  This macro must not be enabled as a safety model by itself: it only fixes
  stable frame names while the controlled CAD mesh, collision envelope,
  inertia and limits are pending.  The future gripper macro will add visual,
  collision and movable links below gripper_base.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="thesis_gripper_interface"
      params="parent prefix mount_xyz:='0 0 0' mount_rpy:='0 0 0'
              tcp_xyz:='0 0 0' tcp_rpy:='0 0 0'">
    <link name="${prefix}_tool_mount"/>
    <joint name="${prefix}_tool_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}_tool_mount"/>
      <origin xyz="${mount_xyz}" rpy="${mount_rpy}"/>
    </joint>

    <link name="${prefix}_gripper_base"/>
    <joint name="${prefix}_gripper_base_joint" type="fixed">
      <parent link="${prefix}_tool_mount"/>
      <child link="${prefix}_gripper_base"/>
    </joint>

    <link name="${prefix}_gripper_tcp"/>
    <joint name="${prefix}_gripper_tcp_joint" type="fixed">
      <parent link="${prefix}_gripper_base"/>
      <child link="${prefix}_gripper_tcp"/>
      <origin xyz="${tcp_xyz}" rpy="${tcp_rpy}"/>
    </joint>
  </xacro:macro>
</robot>
