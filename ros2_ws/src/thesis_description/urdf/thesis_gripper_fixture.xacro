<?xml version="1.0"?>
<!--
  Synthetic integration fixture used only by offline safety tests.

  Its dimensions, mass and inertia are deliberately test data. They do not
  approximate or validate the future thesis gripper. The stable integration
  frames come from thesis_gripper_interface.xacro so this fixture can later be
  replaced without changing the three-arm launch contract.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="thesis_gripper_fixture" params="prefix">
    <link name="${prefix}_fixture_body">
      <visual>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <geometry><box size="0.10 0.10 0.12"/></geometry>
        <material name="synthetic_fixture_orange">
          <color rgba="0.95 0.35 0.05 0.80"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <geometry><box size="0.10 0.10 0.12"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <mass value="0.25"/>
        <inertia ixx="0.000508" ixy="0" ixz="0"
                 iyy="0.000508" iyz="0" izz="0.000417"/>
      </inertial>
    </link>
    <joint name="${prefix}_fixture_body_joint" type="fixed">
      <parent link="${prefix}_gripper_base"/>
      <child link="${prefix}_fixture_body"/>
    </joint>
  </xacro:macro>
</robot>
