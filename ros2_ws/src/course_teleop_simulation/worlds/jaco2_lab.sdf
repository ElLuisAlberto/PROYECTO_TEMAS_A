<?xml version="1.0"?>
<sdf version="1.8">
  <!-- The robot base is fixed at world z=0; the tabletop finishes at z=0. -->
  <world name="teleoperation_lab">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <gravity>0 0 -9.80665</gravity>
    <scene>
      <ambient>0.65 0.62 0.58 1</ambient>
      <background>0.78 0.75 0.69 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows><pose>0 0 8 0 0 0</pose>
      <diffuse>0.94 0.90 0.84 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>
    <model name="ground_plane">
      <static>true</static><pose>0 0 -0.72 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="ground_visual"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.46 0.44 0.41 1</ambient><diffuse>0.62 0.59 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="work_table">
      <static>true</static>
      <link name="table_link">
        <collision name="top_collision"><pose>0.30 0 -0.03 0 0 0</pose><geometry><box><size>1.20 0.90 0.06</size></box></geometry></collision>
        <visual name="top_visual"><pose>0.30 0 -0.03 0 0 0</pose><geometry><box><size>1.20 0.90 0.06</size></box></geometry>
          <material><ambient>0.34 0.25 0.17 1</ambient><diffuse>0.61 0.46 0.32 1</diffuse></material>
        </visual>
        <collision name="leg_a_collision"><pose>-0.22 -0.38 -0.39 0 0 0</pose><geometry><box><size>0.07 0.07 0.66</size></box></geometry></collision>
        <collision name="leg_b_collision"><pose>-0.22 0.38 -0.39 0 0 0</pose><geometry><box><size>0.07 0.07 0.66</size></box></geometry></collision>
        <collision name="leg_c_collision"><pose>0.82 -0.38 -0.39 0 0 0</pose><geometry><box><size>0.07 0.07 0.66</size></box></geometry></collision>
        <collision name="leg_d_collision"><pose>0.82 0.38 -0.39 0 0 0</pose><geometry><box><size>0.07 0.07 0.66</size></box></geometry></collision>
        <visual name="leg_a_visual"><pose>-0.22 -0.38 -0.39 0 0 0</pose><geometry><box><size>0.07 0.07 0.66</size></box></geometry></visual>
        <visual name="leg_b_visual"><pose>-0.22 0.38 -0.39 0 0 0</pose><geometry><box><size>0.07 0.07 0.66</size></box></geometry></visual>
        <visual name="leg_c_visual"><pose>0.82 -0.38 -0.39 0 0 0</pose><geometry><box><size>0.07 0.07 0.66</size></box></geometry></visual>
        <visual name="leg_d_visual"><pose>0.82 0.38 -0.39 0 0 0</pose><geometry><box><size>0.07 0.07 0.66</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
